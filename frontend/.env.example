# All of these have working testnet defaults baked into src/lib/env.ts for
# the TrueTix pilot deployment, so the app runs with none of this set. Only
# fill these in to point at a different deployment or enable PostHog.

# VITE_CONTRACT_ID=
# VITE_TUSDC_SAC_ID=
# VITE_TUSDC_ISSUER=
# VITE_ORGANIZER_ADDRESS=
# VITE_RPC_URL=
# VITE_NETWORK_PASSPHRASE=
# VITE_HORIZON_URL=

# Analytics/monitoring/feedback (PostHog project settings > API keys)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
